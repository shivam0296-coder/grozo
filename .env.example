# Stage 1 does not load this file. Future apps must validate config at startup.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
CUSTOMER_WEB_ORIGIN=http://localhost:5173
ADMIN_WEB_ORIGIN=http://localhost:5174
DATABASE_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
JWT_SIGNING_PRIVATE_KEY=
JWT_VERIFY_PUBLIC_KEY=
REFRESH_TOKEN_PEPPER=
OTP_PROVIDER=disabled
OTP_PROVIDER_ACCOUNT_ID=
OTP_PROVIDER_SECRET=
OTP_HASH_SECRET=
MAPS_ENABLED=false
MAPS_SERVER_API_KEY=
# Browser key is visible: restrict website referrers AND allowed APIs.
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Store Android keys in ignored local Gradle properties; use separate app keys.
GOOGLE_MAPS_CUSTOMER_ANDROID_KEY=
GOOGLE_MAPS_RIDER_ANDROID_KEY=
PAYMENTS_PROVIDER=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COD_ENABLED=false
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
STORAGE_PROVIDER=disabled
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
AI_PROVIDER=disabled

# Stage 2 browser build-time settings. Live mode has no fixture fallback.
VITE_DATA_MODE=development
VITE_API_BASE_URL=/api/v1

## Final testing modes

# Customer builds default to catalogue; development mode is explicitly labelled. See docs/DEPLOY-WEBSITE.md.
# VITE_DATA_MODE=catalogue
# VITE_API_BASE_URL=  (empty means explicitly bundled public catalogue)
# Android: -PgrozoApiBaseUrl=https://YOUR_TEST_HOST/api/v1/
