  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "grozo_session"
      }
    },
    "schemas": {
      "Category": {
        "type": "object",
        "required": [
          "id",
          "name",
          "parentId",
          "active"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "ProductMetadata": {
        "type": "object",
        "properties": {
          "ingredients": {
            "type": [
              "string",
              "null"
            ]
          },
          "storageInfo": {
            "type": [
              "string",
              "null"
            ]
          },
          "variantAttributes": {
            "type": "object"
          },
          "sourceRecord": {
            "type": "object"
          },
          "subcategoryId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "ImageSource": {
        "type": "object",
        "required": [
          "variantId",
          "sourceUrl",
          "rightsRecord",
          "reviewStatus"
        ],
        "properties": {
          "variantId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceUrl": {
            "type": "string"
          },
          "rightsRecord": {
            "type": "string",
            "minLength": 1
          },
          "reviewStatus": {
            "enum": [
              "pending_review",
              "owner_reviewed",
              "rejected"
            ]
          },
          "reviewedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "reviewNote": {
            "type": [
              "string",
              "null"
            ]
          },
          "thumbnailKey": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ImportReport": {
        "type": "object",
        "required": [
          "sourceCount",
          "importedCount",
          "duplicates",
          "missingImages",
          "mappingErrors"
        ],
        "properties": {
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "importedCount": {
            "type": "integer",
            "minimum": 0
          },
          "duplicates": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "missingImages": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "mappingErrors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "SourceConcept": {
        "type": "object",
        "description": "PDF concept record, never an orderable variant until merchant data is reviewed.",
        "required": [
          "id",
          "name",
          "source",
          "categoryId",
          "pricingStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "brandId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "subcategoryId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "source": {
            "type": "object",
            "required": [
              "file",
              "sha256",
              "page",
              "ordinal",
              "rawText"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "rawText": {
                "type": "string"
              }
            }
          },
          "pricingStatus": {
            "const": "merchant_details_pending"
          },
          "sellable": {
            "const": false
          },
          "reviewFlags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
